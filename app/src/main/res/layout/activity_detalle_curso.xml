
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen principal y boton de regreso -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgCurso"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/curso_programacion"
                android:contentDescription="Curso de programación" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:text="← BACK"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#145A83"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp" />

        </FrameLayout>

        <!-- Informacion del curso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtNombreCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROGRAMACIÓN AVANZADA"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Código: IS102"
                android:textColor="#222222"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="DESCRIPCIÓN:"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="En este curso aprenderás conceptos avanzados de programación, desarrollo de algoritmos y resolución de problemas mediante buenas prácticas de codificación."
                android:textColor="#333333"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="ESPACIO:"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtEspacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Edificio C,Salón 3-10 "
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="TOTAL HORAS:"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtHoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="40 Horas"
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DÍAS DE ATENCIÓN:"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Lunes a jueves &#10;(14:00 - 16:00 hrs)"
                android:textColor="#333333"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
